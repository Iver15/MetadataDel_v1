#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")"/../.. && pwd)"
# Keep the caller's working directory so relative document paths resolve correctly.
case "$(uname -m)" in
  arm64) RID="osx-arm64"; PUBLISH_DIR="$ROOT_DIR/publish-mac" ;;
  x86_64) RID="osx-x64"; PUBLISH_DIR="$ROOT_DIR/publish-mac-x64" ;;
  *) echo "Неподдерживаемая архитектура" >&2; exit 2 ;;
esac

if [ "$#" -eq 0 ]; then
  echo "Использование: bash scripts/mac/mdel <file1> [file2 ...]" >&2
  exit 2
fi

BINARY="$PUBLISH_DIR/MetadataDel"
if [ ! -x "$BINARY" ]; then
  DOTNET_BIN="${DOTNET:-$(command -v dotnet || true)}"
  if [ -z "$DOTNET_BIN" ] && [ -x "$HOME/.dotnet/dotnet" ]; then
    DOTNET_BIN="$HOME/.dotnet/dotnet"
  fi
  if [ -z "$DOTNET_BIN" ]; then
    echo "[ERR] .NET SDK не найден. Укажите DOTNET=/path/to/dotnet." >&2
    exit 1
  fi
  "$DOTNET_BIN" publish "$ROOT_DIR/MetadataDel.MacCli/MetadataDel.MacCli.csproj" \
    -c Release -r "$RID" -p:PublishSingleFile=true -p:SelfContained=true -o "$PUBLISH_DIR"
fi
exec "$BINARY" --log --backup=on "$@"
